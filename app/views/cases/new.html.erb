<% content_for :title, "#{t('case.check_application')} | #{t('civicroute.app_name')}" %>

<div class="breadcrumbs mb-6 text-sm" aria-label="Breadcrumb">
  <ul>
    <li><%= link_to t("nav.services"), root_path %></li>
    <li><%= link_to @public_service.translated_name, public_service_path(@public_service.slug) %></li>
    <li aria-current="page"><%= t("case.check_application") %></li>
  </ul>
</div>

<%= link_to public_service_path(@public_service.slug), class: "btn btn-ghost btn-sm mb-4 gap-1" do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
  <%= t("nav.back_to_service_guide") %>
<% end %>

<div class="mx-auto max-w-2xl">
  <div class="mb-8">
    <p class="mb-2 font-semibold text-primary"><%= @public_service.institution.country.name %> &middot; <%= @public_service.institution.translated_name %></p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl"><%= t("case.check_application") %></h1>
    <p class="mt-4 text-lg leading-8 text-base-content/75">
      <%= t("case.compare_description") %>
    </p>
  </div>

  <div class="alert alert-info mb-8">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 size-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span><%= t("case.internal_systems_notice") %></span>
  </div>

  <turbo-frame id="case-assessment-form">
  <%= simple_form_for @case, class: "space-y-6", data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :public_service_id, value: @public_service.id %>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body space-y-6">
        <h2 class="card-title text-xl">Service</h2>
        <div class="form-control">
          <input type="text" value="<%= @public_service.translated_name %>" class="input input-bordered" disabled />
        </div>
      </div>
    </div>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body space-y-6">
        <h2 class="card-title text-xl"><%= t("case.application_details") %></h2>

        <div class="form-control">
          <%= f.label :application_completed_on, t("case.completed_date"), class: "label" %>
          <%= f.date_field :application_completed_on,
            class: "input input-bordered w-full #{'input-error' if @case.errors[:application_completed_on].any?}",
            max: Date.current.to_s,
            required: true %>
          <% if @case.errors[:application_completed_on].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @case.errors[:application_completed_on].first %></span>
            </label>
          <% end %>
          <label class="label">
            <span class="label-text-alt text-base-content/60"><%= t("case.completed_help") %></span>
          </label>
        </div>

        <div class="form-control">
          <%= f.label :payment_date, "Payment date", class: "label" %>
          <%= f.date_field :payment_date,
            class: "input input-bordered w-full #{'input-error' if @case.errors[:payment_date].any?}",
            max: Date.current.to_s %>
          <% if @case.errors[:payment_date].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @case.errors[:payment_date].first %></span>
            </label>
          <% end %>
          <label class="label">
            <span class="label-text-alt text-base-content/60"><%= t("case.payment_help") %></span>
          </label>
        </div>

        <div class="form-control">
          <%= f.label :portal_created_on, "Portal Date Created", class: "label" %>
          <%= f.date_field :portal_created_on,
            class: "input input-bordered w-full #{'input-error' if @case.errors[:portal_created_on].any?}",
            max: Date.current.to_s %>
          <% if @case.errors[:portal_created_on].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @case.errors[:portal_created_on].first %></span>
            </label>
          <% end %>
          <label class="label">
            <span class="label-text-alt text-base-content/60">This is the date labelled "Date Created" on the Lands Commission tracking page. It may be different from when you completed your application.</span>
          </label>
        </div>

        <div class="form-control">
          <%= f.label :region, "Region *", class: "label" %>
          <%= f.select :region,
            options_for_select(CivicRoute::REGIONS, @case.region),
            { include_blank: t("case.select_region") },
            class: "select select-bordered w-full #{'select-error' if @case.errors[:region].any?}",
            required: true %>
          <% if @case.errors[:region].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @case.errors[:region].first %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body space-y-6">
        <h2 class="card-title text-xl"><%= t("case.portal_question") %></h2>
        <p class="text-sm text-base-content/60"><%= t("case.portal_help") %></p>

        <% @tracking_steps.each do |step| %>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold"><%= step.translated_name %></span>
            </label>
            <select name="milestones[<%= step.id %>]"
              class="select select-bordered w-full">
              <option value=""><%= t("case.select_status") %></option>
              <% @portal_statuses.each do |status_record| %>
                <% status = status_record.name %>
                <option value="<%= status %>"
                  <%= "selected" if params.dig(:milestones, step.id.to_s) == status %>>
                  <%= status %>
                </option>
              <% end %>
            </select>
          </div>
        <% end %>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold"><%= t("case.overall_status") %></span>
          </label>
          <input type="text" name="case_observation[overall_status]"
            value="<%= params.dig(:case_observation, :overall_status) %>"
            class="input input-bordered w-full"
            placeholder="<%= t('case.leave_blank') %>" />
          <label class="label">
            <span class="label-text-alt text-base-content/60">Leave blank if the tracking page does not show an overall status.</span>
          </label>
        </div>
      </div>
    </div>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body space-y-6">
        <h2 class="card-title text-xl"><%= t("case.observation_question") %></h2>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold"><%= t("case.observation_date") %></span>
          </label>
          <%= date_field_tag "case_observation[observed_on]",
            params.dig(:case_observation, :observed_on) || Date.current.to_s,
            class: "input input-bordered w-full",
            max: Date.current.to_s,
            required: true %>
          <% if @observation&.errors&.[](:observed_on)&.any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:observed_on].first %></span>
            </label>
          <% end %>
          <label class="label">
            <span class="label-text-alt text-base-content/60"><%= t("case.observation_help") %></span>
          </label>
        </div>
      </div>
    </div>

    <% if @observation&.errors&.any? %>
      <div class="alert alert-error" role="alert">
        <span><%= @observation.errors.full_messages.to_sentence %></span>
      </div>
    <% end %>

    <div class="card-actions justify-end">
      <%= f.submit t("case.assess"), class: "btn btn-primary btn-wide" %>
    </div>
  <% end %>
  </turbo-frame>
</div>
