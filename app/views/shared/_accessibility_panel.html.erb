<button type="button"
  class="btn btn-ghost btn-sm whitespace-nowrap"
  aria-expanded="false"
  aria-controls="accessibility-settings"
  data-accessibility-target="button"
  data-action="accessibility#togglePanel">
  <%= t("accessibility.control") %>
</button>

<div id="accessibility-settings"
  class="accessibility-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="accessibility-settings-title"
  data-accessibility-target="panel"
  data-action="click->accessibility#closeFromBackdrop keydown->accessibility#handleKeydown"
  hidden>
  <div class="accessibility-dialog__panel">
    <div class="flex items-start justify-between gap-4">
      <h2 id="accessibility-settings-title" class="text-xl font-bold"><%= t("accessibility.title") %></h2>
      <button type="button" class="btn btn-ghost btn-sm" data-action="accessibility#closePanel"><%= t("accessibility.close") %></button>
    </div>

    <fieldset class="mt-5">
      <legend class="font-semibold"><%= t("accessibility.text_size") %></legend>
      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3">
        <% [["normal", t("accessibility.normal")], ["large", t("accessibility.large")], ["extra-large", t("accessibility.extra_large")]].each do |value, label| %>
          <label class="accessibility-choice">
            <input type="radio" name="accessibility-text-size" value="<%= value %>" class="radio radio-primary radio-sm" data-accessibility-target="textSize" data-action="change->accessibility#changeTextSize">
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="mt-5 divide-y divide-base-300 border-y border-base-300">
      <% [
        ["highContrast", "high_contrast"],
        ["enhancedFocus", "enhanced_focus"],
        ["underlineLinks", "underline_links"],
        ["increasedSpacing", "increase_spacing"],
        ["reduceMotion", "reduce_motion"]
      ].each do |target, key| %>
        <label class="flex min-h-12 cursor-pointer items-center justify-between gap-4 py-3">
          <span class="font-medium"><%= t("accessibility.#{key}") %></span>
          <input type="checkbox" class="toggle toggle-primary" data-accessibility-target="<%= target %>" data-accessibility-setting="<%= target %>" data-action="change->accessibility#changeToggle">
        </label>
      <% end %>
    </div>

    <div class="mt-5" aria-labelledby="read-aloud-title">
      <h3 id="read-aloud-title" class="font-semibold"><%= t("accessibility.read_aloud") %></h3>
      <p class="mt-1 text-sm text-base-content/70"><%= t("accessibility.read_aloud_privacy") %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-accessibility-target="listen" data-action="accessibility#listen"><%= t("accessibility.listen") %></button>
        <button type="button" class="btn btn-outline btn-sm" data-accessibility-target="pause" data-action="accessibility#pauseOrResume" hidden><%= t("accessibility.pause") %></button>
        <button type="button" class="btn btn-outline btn-sm" data-accessibility-target="stop" data-action="accessibility#stop" hidden><%= t("accessibility.stop") %></button>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-base-300 pt-4">
      <button type="button" class="btn btn-outline btn-sm" data-action="accessibility#reset"><%= t("accessibility.reset") %></button>
      <p id="accessibility-status" class="min-h-5 text-sm" role="status" aria-live="polite" data-accessibility-target="status"></p>
    </div>
  </div>
</div>
