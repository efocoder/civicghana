<% content_for :title, "#{t('homepage.tagline')} | #{t('civicroute.app_name')}" %>

<section class="mx-auto max-w-6xl">
  <div class="hero bg-base-100 rounded-2xl border border-base-300 mb-10 overflow-hidden">
    <div class="hero-content flex-col lg:flex-row gap-8 lg:gap-12 py-10 lg:py-16 px-6 lg:px-12 w-full">
      <div class="flex-1">
        <div class="badge badge-primary badge-outline mb-4"><%= t("homepage.tagline") %></div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl leading-tight"><%= t("homepage.headline") %></h1>
        <p class="mt-4 text-lg leading-8 text-base-content/75 max-w-xl">
          <%= t("homepage.subtitle") %>
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <% if @public_services.first %>
            <%= link_to t("homepage.view_guide"), public_service_path(@public_services.first.slug), class: "btn btn-primary" %>
            <% if @public_services.first.tracking_available? %>
              <%= link_to t("common.check_application"), new_case_path(service_slug: @public_services.first.slug), class: "btn btn-outline" %>
            <% end %>
          <% end %>
        </div>
      </div>
      <div id="how-it-works" class="flex-shrink-0 w-full lg:w-80">
        <div class="card bg-base-200 border border-base-300">
          <div class="card-body p-5">
            <h2 class="card-title text-sm text-base-content/60 mb-3"><%= t("nav.how_it_works") %></h2>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-primary-content text-xs font-bold">1</span>
                <p class="text-sm text-base-content/80"><%= t("homepage.step_verified_rule") %></p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-primary-content text-xs font-bold">2</span>
                <p class="text-sm text-base-content/80"><%= t("homepage.step_compare") %></p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-primary-content text-xs font-bold">3</span>
                <p class="text-sm text-base-content/80"><%= t("homepage.step_discrepancy") %></p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-primary-content text-xs font-bold">4</span>
                <p class="text-sm text-base-content/80"><%= t("homepage.step_action") %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-base-content/60"><%= t("homepage.available_services") %></h2>
  <p class="-mt-4 mb-5 max-w-2xl text-base text-base-content/70"><%= t("homepage.services_intro") %></p>

  <%= form_with url: root_path, method: :get, class: "mb-6 grid gap-3 rounded-box border border-base-300 bg-base-100 p-4 md:grid-cols-4" do |form| %>
    <div class="form-control">
      <%= form.label :q, t("homepage.search_services"), class: "label font-semibold" %>
      <%= form.search_field :q, value: params[:q], class: "input input-bordered" %>
    </div>
    <div class="form-control">
      <%= form.label :agency_id, t("homepage.agency"), class: "label font-semibold" %>
      <%= form.select :agency_id, options_from_collection_for_select(@agencies, :id, :translated_name, params[:agency_id]), { include_blank: t("homepage.all_agencies") }, class: "select select-bordered" %>
    </div>
    <div class="form-control">
      <%= form.label :unit_id, t("homepage.unit"), class: "label font-semibold" %>
      <%= form.select :unit_id, options_from_collection_for_select(@units, :id, :translated_name, params[:unit_id]), { include_blank: t("homepage.all_units") }, class: "select select-bordered" %>
    </div>
    <%= form.submit t("homepage.filter"), class: "btn btn-primary self-end" %>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <% @public_services.each do |service| %>
      <article class="card border border-base-300 bg-base-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="badge badge-neutral"><%= service.institution.country.name %></span>
            <span class="text-base-content/60"><%= service.institution.translated_name %></span>
            <% if service.organizational_unit %><span class="badge badge-ghost"><%= service.organizational_unit.translated_name %></span><% end %>
            <span class="badge badge-outline" title="CivicRoute support available for this service">
              <%= t("homepage.support_levels.#{service.support_level}") %>
            </span>
          </div>
          <div>
            <h3 class="card-title text-xl lg:text-2xl"><%= service.translated_name %></h3>
            <p class="mt-2 leading-7 text-base-content/75 text-sm lg:text-base"><%= service.translated_description %></p>
          </div>
          <div class="card-actions justify-end">
            <%= link_to(service.directory? ? t("common.view_service") : t("common.view_guide"), public_service_path(service.slug), class: "btn btn-primary btn-sm") %>
            <% if service.tracking_available? %>
              <%= link_to t("common.check_application"), new_case_path(service_slug: service.slug), class: "btn btn-outline btn-sm" %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
    <% if @public_services.empty? %>
      <div class="civic-surface col-span-full p-8 text-center" role="status">
        <h3 class="text-xl font-bold"><%= t("homepage.no_services") %></h3>
        <p class="mt-2 text-base-content/70"><%= t("homepage.try_filters") %></p>
        <%= link_to t("common.clear_filters"), root_path, class: "btn btn-outline btn-sm mt-4" %>
      </div>
    <% end %>
  </div>
</section>
