<% content_for :title, "Record an update | CivicRoute Ghana" %>

<div class="breadcrumbs mb-6 text-sm" aria-label="Breadcrumb">
  <ul>
    <li><%= link_to "Services", root_path %></li>
    <li><%= link_to @case.public_service.name, public_service_path(@case.public_service.slug) %></li>
    <li><%= link_to "Assessment", case_path(@case) %></li>
    <li aria-current="page">Record an update</li>
  </ul>
</div>

<%= link_to case_path(@case), class: "btn btn-ghost btn-sm mb-4 gap-1" do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
  Back to assessment
<% end %>

<div class="mx-auto w-full max-w-4xl min-w-0">
  <div class="mb-8 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Record an update</h1>
    <p class="mt-4 text-lg leading-8 text-base-content/75">
      Add information you received or observed after your previous case assessment.
    </p>
    <p class="mt-3 text-base text-base-content/65">This creates a dated evidence record. CivicRoute uses it to compare institutional updates with what the public portal displays.</p>
  </div>

  <%= simple_form_for @observation, url: case_observations_path(@case), scope: :case_observation, class: "case-form min-w-0 space-y-8 sm:space-y-10", data: { controller: "evidence-form" } do |f| %>
    <% if @observation.errors.any? %>
      <div class="alert alert-error" role="alert" aria-live="assertive">
        <div>
          <h2 class="font-semibold">Please review this update</h2>
          <ul class="mt-1 list-disc pl-5 text-sm">
            <% @observation.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </div>
      </div>
    <% end %>
    <div class="card mb-8 min-w-0 border border-base-300 bg-base-100">
      <div class="card-body min-w-0 space-y-5">
        <div><h2 class="card-title text-xl">Where did this information come from?</h2><p class="mt-1 text-base text-base-content/65">Choose the channel you used to receive or observe the update.</p></div>

        <fieldset class="form-control min-w-0">
          <legend class="sr-only">Information source</legend>
          <div class="grid gap-3 sm:grid-cols-2">
          <% CivicRoute::EVIDENCE_SOURCES.each do |key, label| %>
            <label class="label min-w-0 cursor-pointer justify-start gap-3 rounded-lg border border-base-300 px-4 py-3 hover:bg-base-200">
              <%= f.radio_button :observation_type, key,
                class: "radio radio-primary",
                data: { action: "change->evidence-form#toggleFields" } %>
              <span class="label-text break-words"><%= label %></span>
            </label>
          <% end %>
          </div>
          <% if @observation.errors[:observation_type].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:observation_type].first %></span>
            </label>
          <% end %>
        </fieldset>
      </div>
    </div>

    <div class="card mb-8 min-w-0 border border-base-300 bg-base-100">
      <div class="card-body min-w-0 space-y-5">
        <h2 class="card-title text-xl">When did you receive this information?</h2>
        <p class="text-base text-base-content/65">Use the date you saw the portal status or received the institution’s update.</p>

        <div class="form-control">
          <%= f.label :observed_on, "Date received *", class: "label" %>
          <%= f.date_field :observed_on,
            class: "input input-bordered w-full #{'input-error' if @observation.errors[:observed_on].any?}",
            max: Date.current.to_s,
            required: true %>
          <% if @observation.errors[:observed_on].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:observed_on].first %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-8 min-w-0 border border-base-300 bg-base-100" id="non-portal-fields">
      <div class="card-body min-w-0 space-y-5">
        <h2 class="card-title text-xl">How was the application's progress described?</h2>

        <fieldset class="form-control min-w-0">
          <legend class="sr-only">Progress described by the institution</legend>
          <div class="grid gap-3 sm:grid-cols-2">
          <% CivicRoute::PROGRESS_CLAIMS.each do |key, label| %>
            <label class="label min-w-0 cursor-pointer justify-start gap-3 rounded-lg border border-base-300 px-4 py-3 hover:bg-base-200">
              <%= f.radio_button :progress_claim, key,
                class: "radio radio-primary",
                data: { action: "change->evidence-form#toggleMilestoneField" } %>
              <span class="label-text break-words"><%= label %></span>
            </label>
          <% end %>
          <% if @observation.errors[:progress_claim].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:progress_claim].first %></span>
            </label>
          <% end %>
          </div>
        </fieldset>

        <div class="form-control" id="milestone-select" style="display: none;">
          <%= f.label :reported_process_step_id, "Which milestone?", class: "label" %>
          <%= f.select :reported_process_step_id,
            options_from_collection_for_select(@tracking_steps, :id, :name, @observation.reported_process_step_id),
            { include_blank: "Select a milestone" },
            class: "select select-bordered w-full" %>
          <% if @observation.errors[:reported_process_step_id].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:reported_process_step_id].first %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-8 min-w-0 border border-base-300 bg-base-100" id="summary-field">
      <div class="card-body min-w-0 space-y-5">
        <h2 class="card-title text-xl">What were you told?</h2>

        <div class="alert alert-warning">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 size-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
          <span>Do not include Ghana Card numbers, phone numbers, personal addresses, passwords, or other unnecessary personal information.</span>
        </div>

        <div class="form-control">
          <%= f.label :summary, "Summary", class: "label" %>
          <%= f.text_area :summary,
            class: "textarea textarea-bordered w-full h-32 #{'textarea-error' if @observation.errors[:summary].any?}",
            placeholder: "Describe what you were told or observed..." %>
          <% if @observation.errors[:summary].any? %>
            <label class="label">
              <span class="label-text-alt text-error"><%= @observation.errors[:summary].first %></span>
            </label>
          <% end %>
          <label class="label">
            <span class="label-text-alt text-base-content/60">Maximum 1000 characters</span>
          </label>
        </div>
      </div>
    </div>

    <div class="card mb-8 min-w-0 border border-base-300 bg-base-100" id="portal-snapshot-fields" style="display: none;">
      <div class="card-body min-w-0 space-y-5">
        <h2 class="card-title text-xl">Portal tracking snapshot</h2>
        <p class="text-sm text-base-content/60">Record the status currently displayed for each tracking milestone.</p>

        <div class="grid min-w-0 gap-6 md:grid-cols-2">
        <% @tracking_steps.each do |step| %>
          <div class="form-control min-w-0">
            <label class="label">
              <span class="label-text break-words font-semibold"><%= step.name %></span>
            </label>
            <select name="milestones[<%= step.id %>]"
              class="select select-bordered w-full">
              <option value="">Select status</option>
              <% @portal_statuses.each do |status_record| %>
                <% status = status_record.name %>
                <option value="<%= status %>"><%= status %></option>
              <% end %>
            </select>
          </div>
        <% end %>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold">Overall status shown by the portal</span>
          </label>
          <%= f.text_field :overall_status,
            class: "input input-bordered w-full",
            placeholder: "Leave blank if not shown" %>
        </div>
      </div>
    </div>

    <div class="card-actions justify-end">
      <%= f.submit "Save this update", class: "btn btn-primary btn-wide" %>
    </div>
  <% end %>
</div>
