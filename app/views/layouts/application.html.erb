<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("civicroute.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CivicRoute">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1e3a5f">
    <meta name="description" content="CivicRoute helps Ghanaian citizens understand public-service processes using verified, sourced official rules.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200 text-base-content">
    <header class="border-b border-base-300 bg-base-100" role="banner">
      <div class="navbar mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex-1">
          <%= link_to root_path, class: "text-lg font-bold tracking-tight text-primary" do %>
            CivicRoute <span class="text-base-content">Ghana</span>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <nav aria-label="Language" class="flex items-center gap-2 text-sm">
            <label for="locale-select" class="sr-only">Language</label>
            <select id="locale-select" class="select select-bordered select-sm" onchange="if (this.value) window.location.href = this.value">
              <% { en: "English", tw: "Twi", fr: "Français", ee: "Eʋegbe" }.each do |locale, name| %>
                <option value="<%= url_for(locale: locale) %>" <%= "selected" if I18n.locale == locale %>><%= name %></option>
              <% end %>
            </select>
          </nav>
          <div class="badge badge-outline badge-sm sm:badge-md"><%= t("civicroute.independent_tool") %></div>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12" role="main">
      <%= yield %>
    </main>

    <footer class="border-t border-base-300 bg-base-100" role="contentinfo">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-base-content/70 sm:px-6">
        <%= t("civicroute.not_affiliated") %>
      </div>
    </footer>

    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js").catch(function() {});
      }
    </script>
  </body>
</html>
